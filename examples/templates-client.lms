# End-to-end GCS/Pub/Sub template client. Run through scripts/test-templates.py
# with expected.json from examples/templates.lms and the pinned lmgcp binary.
context = read_json("expected.json");
create = context.create;
object = context.object;
pubsub = context.pubsub;
body = json_stringify(object.content);
if (ARGV[0] == "run") {
  program = _lmcode_ cli="lmgcp" install="github:lmctl-ai/lmgcp@v0.1.17";
    let bucket = gcp.storage_create_bucket(${create.name}, ${create.location}, ${create.storageClass});
    if (bucket.name() != ${create.name}) { assert_close(0.0, 1.0, 0.0); }
    let labels = str_map().set("wave", ${create.labels.wave});
    let labeled = gcp.storage_set_bucket_labels(${create.name}, labels);
    if (!labeled) { assert_close(0.0, 1.0, 0.0); }
    let uploaded = gcp.storage_put_object(${create.name}, ${object.name}, ${body}, ${object.contentType});
    if (!uploaded) { assert_close(0.0, 1.0, 0.0); }
    let read = gcp.storage_read_object(${create.name}, ${object.name});
    if (read != ${body}) { assert_close(0.0, 1.0, 0.0); }
    let topic = gcp.pubsub_create_topic(${pubsub.topic});
    let sub = gcp.pubsub_create_subscription(${pubsub.subscription}, ${pubsub.topic}, ${pubsub.ackDeadlineSeconds}, "");
    let attrs = str_map().set("note", ${pubsub.attributes.note});
    let id = gcp.pubsub_publish(${pubsub.topic}, ${pubsub.message}, attrs);
    if (id == "") { assert_close(0.0, 1.0, 0.0); }
    $return = "template workload complete";
end _lmcode_
  result = run_lmcode(program, {command:[env("LMGCP_BINARY"), "--lmcode", "$DSLFILE"]});
  assert(result.ok, "template workload failed: " + json_stringify(result));
  println("PASS templates run");
  println(json_stringify(result.result));
} else if (ARGV[0] == "denied") {
  program = _lmcode_ cli="lmgcp" install="github:lmctl-ai/lmgcp@v0.1.17";
    let bucket = gcp.storage_get_bucket("lmgcp-denied");
    $return = bucket.name();
end _lmcode_
  result = run_lmcode(program, {command:[env("LMGCP_BINARY"), "--lmcode", "$DSLFILE"]});
  assert(!result.ok && contains(json_stringify(result), "403"), "expected a controlled denied result: " + json_stringify(result));
  println("PASS templates denied");
  println(json_stringify(result));
} else { assert(false, "expected run or denied"); }
